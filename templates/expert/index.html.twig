{% extends 'base.html.twig' %}

{% block title %}Expert index{% endblock %}

{% block body %}
    <h1>Expert index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Specialite</th>
                <th>Biographie</th>
                <th>Disponibilite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for expert in experts %}
            <tr>
                <td>{{ expert.id }}</td>
                <td>{{ expert.specialite }}</td>
                <td>{{ expert.biographie }}</td>
                <td>{{ expert.disponibilite }}</td>
                <td>
                    <a href="{{ path('app_expert_show', {'id': expert.id}) }}">show</a>
                    <a href="{{ path('app_expert_edit', {'id': expert.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_expert_new') }}">Create new</a>
{% endblock %}
